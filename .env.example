# URL publica del sitio (sin barra final). Cambiar al dominio real cuando se confirme.
NEXT_PUBLIC_SITE_URL=https://martinez-seguros.vercel.app
# ID de Google Analytics 4 (ej: G-XXXXXXXXXX). Vacio = analitica desactivada.
NEXT_PUBLIC_GA_ID=
# Dejar vacio hasta el lanzamiento: el sitio lleva noindex y robots.txt bloquea buscadores.
# Poner 1 el dia que se publique la version definitiva.
NEXT_PUBLIC_ALLOW_INDEXING=
